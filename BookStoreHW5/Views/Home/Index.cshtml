@model BookStoreHW5.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

@section Styles
{
    <style>
        .book-list {
            display: flex;
            flex-wrap: wrap;
        }

        .book-card {
            border: 1px solid #cccccc;
            padding: 20px;
            margin: 10px;
            width: 280px;
            max-width: 100%;
            border-radius: 8px;
            background-color: #f8f9fa;
            overflow-wrap: anywhere;
        }
    </style>
}

<h1>Book Store</h1>

@if (TempData["Message"] != null)
{
    <p class="alert alert-warning">@TempData["Message"]</p>
}

<div class="row">
    <div class="col-md-6">
        <h2>Add Book</h2>

        <form method="post" action="/Home/AddBook">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" id="title" name="title"
                       class="form-control" required />
            </div>

            <div class="mb-3">
                <label for="price" class="form-label">Price</label>
                <input type="number" id="price" name="price"
                       class="form-control" min="0" step="0.01" required />
            </div>

            <div class="mb-3">
                <label for="authorId" class="form-label">Author</label>

                <select id="authorId" name="authorId"
                        class="form-select" required>
                    <option value="">Select an author</option>

                    @foreach (var author in Model.Authors)
                    {
                        <option value="@author.Id">@author.Name</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary">
                Add Book
            </button>
        </form>
    </div>

    <div class="col-md-6">
        <h2>Add Author</h2>

        <form method="post" action="/Home/AddAuthor">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="name" class="form-label">Name</label>
                <input type="text" id="name" name="name"
                       class="form-control" required />
            </div>

            <div class="mb-3">
                <label for="country" class="form-label">Country</label>
                <input type="text" id="country" name="country"
                       class="form-control" required />
            </div>

            <button type="submit" class="btn btn-success">
                Add Author
            </button>
        </form>
    </div>
</div>

<hr />

<h2>Available Books</h2>

@if (Model.Books.Count == 0)
{
    <p>No books available</p>
}
else
{
    <div class="book-list">
        @foreach (var book in Model.Books)
        {
            <div class="book-card">
                <h3>@book.Title</h3>
                <p>Author: @book.AuthorName</p>
                <p>Price: Rs. @book.Price.ToString("0.00")</p>

                <form method="post" action="/Home/RemoveBook"
                      onsubmit="return confirmRemove();">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@book.Id" />

                    <button type="submit" class="btn btn-danger">
                        Remove
                    </button>
                </form>
            </div>
        }
    </div>
}
<hr />

<h2>Authors</h2>

@if (Model.Authors.Count == 0)
{
    <p>No authors available. Add an author before adding a book.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Name</th>
                <th>Country</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var author in Model.Authors)
            {
                <tr>
                    <td>@author.Name</td>
                    <td>@author.Country</td>
                    <td>
                        <form method="post" action="/Home/RemoveAuthor">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="id"
                                   value="@author.Id" />

                            <button type="submit"
                                    class="btn btn-danger btn-sm">
                                Remove Author
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
@section Scripts
{
    <script>
        function confirmRemove() {
            return confirm("Remove this book?");
        }
    </script>
}